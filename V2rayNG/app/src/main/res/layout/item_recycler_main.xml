<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_v04_server_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="11dp"
        android:paddingEnd="8dp"
        android:paddingBottom="11dp">

        <View
            android:id="@+id/layout_indicator"
            android:layout_width="4dp"
            android:layout_height="64dp"
            android:background="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_test_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_v04_ping"
                    android:gravity="center"
                    android:minWidth="62dp"
                    android:paddingStart="9dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="6dp"
                    android:text="-- ms"
                    android:textColor="#8EA5B2"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#4CE8CF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_statistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#A8BDC8"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/layout_subscription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_v04_sub_tag"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/tv_subscription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B8D3DF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/layout_share"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="اشتراک"
                android:textColor="#D7E7ED"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/layout_edit"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="ویرایش"
                android:textColor="#D7E7ED"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/layout_remove"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="حذف"
                android:textColor="#FF8D96"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/layout_more"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="بیشتر"
                android:textColor="#D7E7ED"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
